{
  "time_created": "{{ time_created }}",
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- Marketplace description: the populate script emits an empty/one-line brief,
    but the validator requires >=2 paragraphs (teaser + detail + how-to). Build
    it here so every rendered offering is compliant. #}
{%- set _brief = description | default(display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name, true) %}
{%- if not _brief %}{% set _brief = display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name %}{% endif %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details.context_length else '' %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' over an OpenAI-compatible API' ~ _ctx ~ '. Reach it through the UnitySVC gateway two ways: use UnitySVC-managed access (token usage billed by UnitySVC), or bring your own ' ~ provider_display_name ~ ' API key on the byok channel (billed by ' ~ provider_display_name ~ ' directly).' %}
{%- set _howto = 'The endpoint accepts both OpenAI Chat Completions and Anthropic Messages requests — the gateway auto-detects the dialect, translates to the upstream, and returns the response in the format you sent. See the code examples for both styles.' %}
{%- set _description = _brief ~ '\n\n' ~ _detail ~ '\n\n' ~ _howto %}
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "tags": ["ai", "gateway", "byok"],
  "details": {{ dict(details or {}, input_formats=["openai", "anthropic"], output_formats=["openai_response", "anthropic_response"]) | tojson }},
{%- if payout_price %}
  "payout_price": {{ payout_price | tojson }},
{%- endif %}
  "upstream_access_config": {
    "managed": {
      "access_method": "http",
      "api_key": "${ secrets.{{ env_api_key_name }} }",
      "base_url": "{{ api_base_url | replace('/v2', '') }}",
      "rate_limits": [],
      "routing_key": {
        "model": "{{ offering_name }}"
      },
      "request_transformer": {
        "llm_translator": "anthropic_to_openai"
      }
    },
    "byok": {
      "access_method": "http",
      "api_key": "${ customer_secrets.{{ env_api_key_name }} }",
      "base_url": "{{ api_base_url | replace('/v2', '') }}",
      "rate_limits": [],
      "routing_key": {
        "model": "{{ offering_name }}"
      },
      "request_transformer": {
        "llm_translator": "anthropic_to_openai"
      }
    }
  }
}
