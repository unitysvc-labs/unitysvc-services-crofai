{
  "time_created": "{{ time_created }}",
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
  {#- Channel-keyed price: byok is free (the customer's own key pays CrofAI
      directly); managed resells CrofAI tokens at the per-model rate carried in
      the param `list_price`. Channel keys MUST match the offering channels.

      Price-cell copy follows the marketplace description grammar
      (unitysvc/unitysvc#1886, PR #1887):

          <amount> [ ("/"|"per") <unit> ] [ "~"[intent] <badge> ]* [ "|" <note> ]

      The description that matters is the one on the CHANNEL price, not the
      sub-channel ones. CatalogServiceRow hands the whole `list_price` to
      PriceTag, and PriceTag is the only component that parses a description;
      the sub-channel prices reach ChannelDisplay's PriceBadge, which prints
      whatever it is given verbatim. A channel-keyed price carrying neither a
      top-level `description` nor a top-level `price` falls through PriceTag's
      structured branch to `isFree`, so every metered model in this catalog
      renders a green "Free" today.

      This is a two-price catalog (input + output), and the grammar refuses to
      split two prices on purpose — "$0.18 / $0.35 per 1M input/output tokens"
      fails the unit test (currency in the tail, second separator in the tail)
      and falls through as ONE long unstyled amount. So the cell leads with the
      input rate, names "1M input tokens" as its unit so the figure can't be
      misread as covering both directions, and puts the output rate in the `|`
      note. That slot is terminal and taken verbatim, so it is free to contain
      "/" and "per" without being re-parsed. The alternative — separate
      `input`/`output` fields — is what the price object ALREADY does; those
      fields are intact and untouched, and this only fixes how the cell reads.

      No badge, deliberately. The row already carries a byok access-method chip
      (AccessMethodBadges renders one per channel type), so a "BYOK" pill here
      would duplicate an affordance the row already has — and the amount beside
      it is the *managed* rate, so a bare `~` badge, which is the green "this
      is a saving" register, would misdescribe the number it sits next to.

      Composed here rather than written into the param file because
      scripts/update_params.py rebuilds `list_price` on the nightly populate
      run (.github/workflows/populate-services.yml, 02:00 UTC) and would drop a
      hand-edited description within a day. `payout_price` is seller-facing and
      is rendered by offering.json.j2 — deliberately untouched here. #}
{%- set _byok_note = ' Free on the byok channel - bring your own ' ~ provider_display_name ~ ' key and pay ' ~ provider_display_name ~ ' directly.' %}
{%- if list_price.input and list_price.output %}
{%- set _cell = '$' ~ list_price.input ~ ' / 1M input tokens | $' ~ list_price.output ~ ' / 1M output tokens.' ~ _byok_note %}
{%- set _managed = '$' ~ list_price.input ~ ' per 1M input tokens, $' ~ list_price.output ~ ' per 1M output tokens' %}
{%- elif list_price.price %}
{%- set _cell = '$' ~ list_price.price ~ ' / 1M tokens |' ~ _byok_note %}
{%- set _managed = '$' ~ list_price.price ~ ' per 1M tokens' %}
{%- endif %}
  "list_price": {
    "type": "channel",
    "default": "managed",
{%- if _cell %}
    "description": {{ _cell | tojson }},
{%- endif %}
    "channels": {
      "byok": {
        "description": "Free — bring your own {{ provider_display_name }} API key; you pay {{ provider_display_name }} directly for tokens",
        "price": "0",
        "type": "constant"
      },
      "managed": {{ dict(list_price, description=_managed) | tojson if _managed else list_price | tojson }}
    }
  },
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  "documents": {
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    {#- CrofAI's API is versioned /v2, not the preset default /v1, so every
        version-bearing preset is overridden. llm_description declares no
        version_prefix and is left bare. sleep_after_test spaces out the
        executed docs against upstream rate limits. #}
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_requests", "version_prefix": "/v2", "meta": {"sleep_after_test": 5}}
    },
    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "version_prefix": "/v2", "meta": {"sleep_after_test": 5}}
    },
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_javascript", "version_prefix": "/v2", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_shell", "version_prefix": "/v2", "meta": {"sleep_after_test": 5}}
    },
    {#- Anthropic-dialect examples: the upstream speaks OpenAI, so specs
        run-tests (local_testing) calls it in OpenAI form, while the gateway
        path speaks Anthropic and exercises the llm_translator end to end. #}
    "Python code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_sdk", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_shell", "meta": {"sleep_after_test": 5}}
    },
    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "version_prefix": "/v2", "meta": {"sleep_after_test": 5}}
    }
  }
}
